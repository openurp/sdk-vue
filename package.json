{
  "name": "@openurp/sdk-vue",
  "version": "0.0.3",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./styles/app-shell.css": "./src/styles/app-shell.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "prepublishOnly": "pnpm run build",
    "release:prepare": "bash scripts/release-prepare.sh",
    "release:finish": "bash scripts/release-finish.sh",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "tdesign-icons-vue-next": "^0.4.0",
    "tdesign-vue-next": "^1.20.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "tdesign-icons-vue-next": "^0.4.0",
    "tdesign-vue-next": "^1.20.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.0"
  }
}
